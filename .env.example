# Copy to .env and adjust as needed. All values below are safe local
# defaults -- the service starts with zero configuration for local dev.
# See docs/environment-variables.md for the full contract, including the
# hosted-provider variables used in production (S3, OTLP, etc.).

# --- Detection / depth models ---
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_DEVICE=cpu
DEPTH_MODEL_NAME=MiDaS_small
DEPTH_DEVICE=cpu

# --- Camera calibration (approximate defaults; see docs/calibration-guide.md) ---
CAMERA_FOCAL_LENGTH_PX=721.5
CAMERA_PRINCIPAL_POINT_X=
CAMERA_PRINCIPAL_POINT_Y=
DEPTH_REFERENCE_OBJECT_HEIGHT_M=1.7

# --- Object storage: STORAGE_BACKEND=local (default, no setup) or s3 (MinIO/AWS S3) ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/artifacts
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=threed-od-artifacts
S3_REGION=us-east-1
S3_USE_SSL=false

# --- MLflow experiment tracking (local file store by default) ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=3d-object-detection

# --- Observability ---
# Leave blank to disable trace export. Point at an OpenTelemetry Collector
# locally (see docker-compose.yml) or a hosted backend (Datadog, Azure
# Monitor OTLP ingestion, etc.) in production.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=threed-od-api
ENABLE_METRICS=true

# --- API limits ---
MAX_UPLOAD_SIZE_MB=25
MAX_VIDEO_DURATION_S=30
JOB_RESULT_TTL_S=3600
API_CORS_ORIGINS=http://localhost:5173
